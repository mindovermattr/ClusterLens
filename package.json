{
  "name": "clusterlens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "install": "CI=1 pnpm install --frozen-lockfile --ignore-scripts",
